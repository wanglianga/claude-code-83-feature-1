# 社区助老理发预约上门与公益补贴平台 - 环境变量示例
# 复制为 .env 后按需修改（验证环境通常只需注入 CC_PUBLISH_PORT）

# 宿主机发布端口（仅应用服务发布到宿主；数据库不发布）
CC_PUBLISH_PORT=3083

# PostgreSQL（仅 compose 内部网络访问）
POSTGRES_DB=haircut
POSTGRES_USER=haircut
POSTGRES_PASSWORD=haircut123

# JWT
JWT_SECRET=community-haircut-platform-jwt-secret-key-2026
JWT_EXPIRE_HOURS=12
